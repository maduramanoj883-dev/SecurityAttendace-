# Copy this file to .env and edit the values before running in production

# Port the server listens on
PORT=3000

# Secret used to sign login tokens — set this to a long random string in production
JWT_SECRET=change-this-to-a-long-random-string

# Default head-office admin account created the first time the server runs
# (change the password immediately after first login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!
